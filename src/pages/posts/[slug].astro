---
import { render } from 'astro:content';
import CategoryPath from '../../components/listing/CategoryPath.astro';
import SeriesTree from '../../components/listing/SeriesTree.astro';
import TableOfContents from '../../components/listing/TableOfContents.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getPublishedPosts, type Post } from '../../lib/posts';

interface Props {
	post: Post;
}

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post.entry);
const tocItems = headings
	.filter((heading) => heading.depth === 2 || heading.depth === 3)
	.map((heading) => ({ id: heading.slug, text: heading.text, level: heading.depth }));
const categoryPosts = (await getPublishedPosts()).filter((item) => item.primary === post.primary);
---

<SiteLayout title={`${post.title} · Gino's Blog`} nav="articles" wide>
	<Fragment slot="sidebar">
		<SeriesTree
			title={post.primary}
			categorySlug={post.primarySlug}
			posts={categoryPosts}
			currentSlug={post.slug}
		/>
	</Fragment>
	<div class="gb-post-layout">
		<article class="gb-post-article">
			<header class="gb-post-header">
				<h1 class="gb-post-title">{post.title}</h1>
				<div class="gb-card-meta gb-post-meta">
					<time class="gb-date" datetime={post.date}>{post.displayDate}</time>
					{post.displayUpdated && <span class="gb-post-updated">更新於 {post.displayUpdated}</span>}
					<CategoryPath primary={post.primary} secondary={post.secondary} />
				</div>
			</header>
			{tocItems.length > 0 && <TableOfContents items={tocItems} variant="mobile" />}
			<div class="gb-prose"><Content /></div>
		</article>
		{tocItems.length > 0 && <TableOfContents items={tocItems} />}
	</div>
</SiteLayout>

<script is:inline define:vars={{ headingIds: tocItems.map((item) => item.id) }}>
	const updateActiveHeading = () => {
		let activeId = headingIds[0];
		for (const id of headingIds) {
			const heading = document.getElementById(id);
			if (heading && heading.getBoundingClientRect().top < 120) activeId = id;
			else break;
		}
		document.querySelectorAll('[data-toc-link]').forEach((link) => {
			if (link instanceof HTMLAnchorElement) {
				if (decodeURIComponent(link.hash.slice(1)) === activeId) link.setAttribute('aria-current', 'true');
				else link.removeAttribute('aria-current');
			}
		});
	};
	document.querySelectorAll('[data-toc-link]').forEach((link) => {
		link.addEventListener('click', (event) => {
			const id = link instanceof HTMLAnchorElement ? decodeURIComponent(link.hash.slice(1)) : '';
			const heading = document.getElementById(id);
			if (heading) {
				event.preventDefault();
				heading.scrollIntoView({ behavior: 'smooth', block: 'start' });
				if (link.closest('.gb-toc-mobile')) link.closest('.gb-toc-mobile').removeAttribute('open');
			}
		});
	});
	window.addEventListener('scroll', updateActiveHeading, { passive: true });
	window.addEventListener('resize', updateActiveHeading);
	updateActiveHeading();

	const images = document.querySelectorAll('.gb-prose img');
	if (images.length) {
		const lightbox = document.createElement('div');
		lightbox.className = 'gb-lightbox';
		lightbox.setAttribute('role', 'dialog');
		lightbox.setAttribute('aria-modal', 'true');
		lightbox.hidden = true;
		lightbox.style.display = 'none';
		const enlargedImage = document.createElement('img');
		lightbox.append(enlargedImage);
		document.body.append(lightbox);
		let previousOverflow = '';
		const closeLightbox = () => {
			lightbox.hidden = true;
			lightbox.style.display = 'none';
			document.body.style.overflow = previousOverflow;
		};
		lightbox.addEventListener('click', closeLightbox);
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && !lightbox.hidden) closeLightbox();
		});
		images.forEach((image) => {
			image.setAttribute('tabindex', '0');
			image.setAttribute('role', 'button');
			image.setAttribute('aria-label', `放大圖片：${image.alt || '文章圖片'}`);
			const openLightbox = () => {
				enlargedImage.src = image.currentSrc || image.src;
				enlargedImage.alt = image.alt;
				lightbox.setAttribute('aria-label', image.alt || '文章圖片');
				previousOverflow = document.body.style.overflow;
				document.body.style.overflow = 'hidden';
				lightbox.hidden = false;
				lightbox.style.display = 'flex';
			};
			image.addEventListener('click', openLightbox);
			image.addEventListener('keydown', (event) => {
				if (event.key === 'Enter' || event.key === ' ') {
					event.preventDefault();
					openLightbox();
				}
			});
		});
	}
</script>
