---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Carousel from '../components/content/Carousel.astro';
import Icon from '../components/Icon.astro';
import ItemCard from '../components/about/ItemCard.astro';
import ItemCards from '../components/about/ItemCards.astro';
import People from '../components/about/People.astro';
import Person from '../components/about/Person.astro';
import PageTitle from '../components/layout/PageTitle.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const aboutMedia = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/about/content/about/**/*.{webp,png,jpg,jpeg}',
	{ eager: true },
);
const songMedia = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/about/music/songs/*.{webp,png,jpg,jpeg}',
	{ eager: true },
);
const peopleMedia = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/about/people/*.{webp,png,jpg,jpeg}',
	{ eager: true },
);
const aboutImage = (name: string) =>
	aboutMedia[`../assets/about/content/about/${name}`].default;
const songImage = (name: string) =>
	songMedia[`../assets/about/music/songs/${name}`].default;
const personImage = (slug: string) =>
	Object.entries(peopleMedia).find(([path]) => path.split('/').pop()?.startsWith(`${slug}.`))?.[1].default;

const arcaeaImages = [
	'faint-light.webp', 'testify-byd.webp', '11-all-pm-1.webp', '11-all-pm-2.webp',
	'lament-rain.webp', '1f1e33.webp', 'testify-ftr.webp', 'infinite-strife.webp',
	'straight-into-the-lights.webp', 'neo-kosmo.webp', 'memory-forest.webp', 'blrink.webp',
].map((name) => aboutImage(`arcaea/${name}`));
const maimaiImages = [
	'maimai-b50.webp', 'our-wrenally.webp', 'regulus.webp', 'southern-cross.webp', 'wanderschaffen-law.webp',
].map((name) => aboutImage(`maimai/${name}`));
