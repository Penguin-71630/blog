---
import ArticlesPage from '../../components/listing/ArticlesPage.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getPublishedPosts } from '../../lib/posts';
import { paginate } from '../../lib/pagination';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	const { total } = paginate(posts, 1);
	return Array.from({ length: Math.max(0, total - 1) }, (_, index) => {
		const page = paginate(posts, index + 2);
		return {
			params: { page: String(page.current) },
			props: page,
		};
	});
}

const { items: posts, current, total } = Astro.props;
---

<SiteLayout title={`Articles · 第 ${current} 頁 · Gino's Blog`} nav="articles">
	<ArticlesPage posts={posts} current={current} total={total} />
</SiteLayout>
