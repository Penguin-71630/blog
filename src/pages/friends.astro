---
import FriendRequestForm from '@components/friends/FriendRequestForm';
import FriendsGrid from '@components/friends/FriendsGrid';
import HomeSider from '@components/layout/HomeSider.astro';
import PageTitle from '@components/ui/PageTitle.astro';
import { CONTENT_PADDING } from '@constants/layout';
import { siteConfig } from '@constants/site-config';
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { Comment } from '@/components/comment';

const title = `友站網址 | ${siteConfig.title}`;
const description = '歡迎互相加友～';
---

<Layout title={title} description={description}>
  <TwoColumnLayout>
    <HomeSider slot="sider" />
    <div class="floating-content shadow-box rounded-lg px-8 py-6">
      <PageTitle title="友站網址" />
      <div class="flex flex-col gap-10">
        <div class="mt-4">
          <FriendsGrid client:load />
        </div>
        <div class="mb-4">
          <FriendRequestForm client:visible />
          <Comment />
        </div>
      </div>
    </div>
  </TwoColumnLayout>
</Layout>
