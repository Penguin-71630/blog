---
import CategoryPage from '../../components/listing/CategoryPage.astro';
import { CATEGORIES } from '../../lib/categories';
import { getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return CATEGORIES.map((category) => ({
		params: { slug: category.slug },
		props: {
			category,
			posts: posts.filter((post) => post.primarySlug === category.slug),
			current: 1,
		},
	}));
}

const { category, posts, current } = Astro.props;
---

<CategoryPage category={category} posts={posts} current={current} />
