---
import ArchiveList from '../components/listing/ArchiveList.astro';
import PageTitle from '../components/layout/PageTitle.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
const postsByYear = new Map<string, { date: string; title: string; href: string; timestamp: number }[]>();

for (const post of posts) {
	const year = post.date.slice(0, 4);
	const yearPosts = postsByYear.get(year) ?? [];
	yearPosts.push({
		date: post.date.slice(0, 10),
		title: post.title,
		href: post.href,
		timestamp: Date.parse(post.date),
	});
	postsByYear.set(year, yearPosts);
}

const groups = [...postsByYear.entries()]
	.sort(([left], [right]) => Number(right) - Number(left))
	.map(([year, yearPosts]) => ({
		year,
		posts: yearPosts
			.sort((left, right) => right.timestamp - left.timestamp)
			.map(({ date, title, href }) => ({ date, title, href })),
	}));
---

<SiteLayout title="Archives · Gino's Blog" nav="archives">
	<div class="gb-page-archives">
		<PageTitle>Archives</PageTitle>
		<p class="gb-archive-count">共 {posts.length} 篇文章</p>
		<ArchiveList groups={groups} />
	</div>
</SiteLayout>
