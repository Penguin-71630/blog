---
import ArticlesPage from '../components/listing/ArticlesPage.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getPublishedPosts } from '../lib/posts';
import { paginate } from '../lib/pagination';

const page = paginate(await getPublishedPosts(), 1);
---

<SiteLayout nav="articles">
	<ArticlesPage posts={page.items} current={page.current} total={page.total} />
</SiteLayout>
