---
// src/components/markdown/Tabs.astro
interface Props {
  gid: string;
  tabs: string[];
}

const { gid, tabs } = Astro.props;
---

<div class="tab-group my-0" data-tab-group={gid}>
  <div class="tab-headers flex flex-wrap not-prose" role="tablist"> {/* 頂部按鈕區域：使用 not-prose 避免被文章的預設 CSS 弄壞排版 */}
    {tabs.map((tabName, index) => (
      <button 
        class="tab-header" 
        role="tab" 
        aria-selected={index === 0 ? "true" : "false"} 
        data-tab-index={index} 
        data-tab-group={gid}
      >
        {tabName}
      </button>
    ))}
  </div>
  <div class="tab-panels mt-[-20px] mb-[-20px] prose md:prose-sm dark:prose-invert max-w-none"> {/* 下方內容面板：加上 prose 讓裡面的表格、清單恢復正常樣式 */}
    {tabs.length > 0 && <div class="tab-panel active" role="tabpanel" data-tab-index="0"><slot name="panel-0" /></div>}
    {tabs.length > 1 && <div class="tab-panel" role="tabpanel" data-tab-index="1"><slot name="panel-1" /></div>}
    {tabs.length > 2 && <div class="tab-panel" role="tabpanel" data-tab-index="2"><slot name="panel-2" /></div>}
    {tabs.length > 3 && <div class="tab-panel" role="tabpanel" data-tab-index="3"><slot name="panel-3" /></div>}
    {tabs.length > 4 && <div class="tab-panel" role="tabpanel" data-tab-index="4"><slot name="panel-4" /></div>}
    {tabs.length > 5 && <div class="tab-panel" role="tabpanel" data-tab-index="5"><slot name="panel-5" /></div>}
    {tabs.length > 6 && <div class="tab-panel" role="tabpanel" data-tab-index="5"><slot name="panel-6" /></div>}
  </div>
</div>