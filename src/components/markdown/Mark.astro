---
interface Props {
  text: string;
  bg_color?: string;
  color?: string;
}

const { 
  text, 
  bg_color = '#f1ecf8', // 預設顏色
  color = '#8669b0'
} = Astro.props;
---

<!-- <span 
  style={`background-color: ${bg-color}; padding: 0.1em 0.25em; border-radius: 0.25em; color: white;`}
>{text}</span> -->



<span 
  style={`background-color: ${bg_color}; padding: 0.1em 0.25em; border-radius: 0.25em; color: ${color};`}
><slot /></span>
