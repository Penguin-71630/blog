---
interface Props {
  text?: string; // 加上問號，因為你可能是用 <slot />
  bg_color?: string;
  color?: string;
}

const { bg_color = '#f1ecf8', color = '#8669b0' } = Astro.props;
---

<span 
  class="custom-mark"
  style={`background-color: ${bg_color} !important; padding: 0.1em 0.25em; border-radius: 0.25em; color: ${color} !important;`}
><slot /></span>