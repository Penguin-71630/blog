---
// src/components/markdown/Columns.astro
import { cn } from '@lib/utils';
import { truncate } from 'fs/promises';

interface Props {
  ratio?: string;
  className?: string;
  noline?: boolean; // 新增分隔線選項
}

const { ratio = 'repeat(2, minmax(0, 1fr))', noline = false, className } = Astro.props;
---

{/* 將預設間距設為 gap-8 (2rem = 32px)，讓細線兩側各有 16px 的空間 */}
<div
  class={cn(
    "custom-columns not-prose my-8 grid gap-8 md:gap-8",
    !noline && "has-divider",
    className,
  )}
>
  <slot />
</div>

<style define:vars={{ ratio }}>
  .custom-columns {
    grid-template-columns: minmax(0, 1fr);
  }

  /* 針對子元素設定相對定位，作為分隔線的對齊基準 */
  .custom-columns.has-divider > :global(:not(:first-child)) {
    position: relative;
  }

  /* 手機版 (單欄)：畫橫向細線 */
  .custom-columns.has-divider > :global(:not(:first-child))::before {
    content: "";
    position: absolute;
    background-color: hsl(var(--border)); /* 自動對應你的淺色/深色主題邊框色 */
    top: -1rem; /* 👇 關鍵修改：對應手機版的 gap-3 (0.75rem)，所以向上位移 0.25rem 即可置中 */
    left: 0;
    right: 0;
    height: 1px;
  }

  /* 桌面版 (多欄)：畫直向細線 */
  @media (min-width: 768px) {
    .custom-columns {
      grid-template-columns: var(--ratio);
    }
    .custom-columns.has-divider > :global(:not(:first-child))::before {
      top: 0;
      bottom: 0;
      left: -1rem; /* 位於水平 gap-6 (1.5rem) 的正中間 */
      width: 1px;
      height: auto;
    }
  }

  /* 列印模式：強制多欄排版 */
  @media print {
    .custom-columns {
      grid-template-columns: var(--ratio);
    }
    .custom-columns.has-divider > :global(:not(:first-child))::before {
      top: 0;
      bottom: 0;
      left: -1rem;
      width: 1px;
      height: auto;
    }
  }
</style>
