---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	images: ImageMetadata[];
	fade?: boolean;
	label?: string;
}

const { images, fade = false, label = '圖片輪播' } = Astro.props;
const aspectRatio = Math.max(0.01, ...images.map((image) => image.height / image.width));
---

<div
	class:list={['gb-carousel', { 'has-fade': fade }]}
	data-carousel
	tabindex="0"
	role="group"
	aria-label={label}
	style={`--carousel-ratio:${aspectRatio}`}
>
	<div class="gb-carousel-frame">
		{images.map((image, index) => (
			<Image
				src={image}
				alt=""
				class:list={['gb-carousel-image', { 'is-active': index === 0 }]}
				data-carousel-slide
				aria-hidden={index === 0 ? 'false' : 'true'}
				loading={index === 0 ? 'eager' : 'lazy'}
			/>
		))}
		<button class="gb-carousel-nav is-prev" type="button" data-carousel-prev aria-label="上一張">‹</button>
		<button class="gb-carousel-nav is-next" type="button" data-carousel-next aria-label="下一張">›</button>
	</div>
	<span class="gb-carousel-counter" data-carousel-counter aria-live="polite">1 / {images.length}</span>
</div>

<script>
	import { initCarousels } from '../../scripts/carousel.js';
	initCarousels();
</script>
