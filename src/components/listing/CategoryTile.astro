---
import { Image } from 'astro:assets';
import CategoryIcon from './CategoryIcon.astro';
import type { Category } from '../../lib/categories';

interface Props {
	category: Category;
	count: number;
}

const { category, count } = Astro.props;
---

<a class:list={['gb-tile', { 'is-plain': !category.bg }]} href={`/categories/${category.slug}/`}>
	{category.bg && <Image class="gb-tile-bg" src={category.bg} alt="" loading="lazy" />}
	<div class="gb-tile-body">
		<span class="gb-tile-name"><CategoryIcon slug={category.slug} size={22} />{category.name}</span>
		<span class="gb-tile-count">{count} 篇</span>
	</div>
</a>
