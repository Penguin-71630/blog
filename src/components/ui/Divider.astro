---
import { cn } from '@lib/utils';

interface Props {
  className?: string;
}

const { className } = Astro.props;
---

<div class={cn("my-4 flex items-center", className)}>
  <span class="h-px grow bg-foreground/40 dark:bg-foreground/60"></span>
  {
    Astro.slots.has("default") && (
      <h1 class="mx-4 font-bold text-2xl text-foreground/60 dark:text-foreground/80 tracking-widest">
        <slot />
      </h1>
    )
  }
  <span class="h-px grow bg-foreground/50 dark:bg-foreground/70"></span>
</div>
